---
# clang-tidy configuration for the NSE HFT system.
# Focused on performance, bug-prone patterns, and the Google style guide.
Checks: >
  bugprone-*,
  performance-*,
  portability-*,
  readability-*,
  google-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -readability-identifier-length,
  -google-readability-todo,
  -bugprone-easily-swappable-parameters

WarningsAsErrors: ''
HeaderFilterRegex: 'src/.*'
FormatStyle: file
CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: '50'
